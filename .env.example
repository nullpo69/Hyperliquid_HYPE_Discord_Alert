# Copy to .env for local testing
# For GitHub Actions, set as repository secret: DISCORD_WEBHOOK_URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Optional overrides
# COOLDOWN_SECONDS=300
# THRESHOLD_5M=0.05
# THRESHOLD_15M=0.08
# THRESHOLD_PREVDAY=0.10
# Empty SYMBOLS monitors all eligible main + trade.xyz perpetuals.
# SYMBOLS=HYPE,BTC,NVDA  # optional ticker allow-list
# MONITORED_DEXES=,xyz   # empty item = main; xyz = trade.xyz
# MIN_OPEN_INTEREST_USD=1000000
# MIN_DAY_VOLUME_USD=1000000
# MAX_ALERTS_PER_RUN=20
# TRIGGER_MODE=both  # price|liquidation|both
# LIQ_ENABLED=1
# LIQ_DROP_PCT_5M=0.04
# LIQ_DROP_PCT_15M=0.07
# LIQ_SINGLE_USD=50000
# LIQ_5M_USD=150000
# LIQ_15M_USD=300000
